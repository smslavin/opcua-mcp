# OPC-UA simulator server settings
OPCUA_PORT=4841
PUBLISH_INTERVAL=2

# The OPC-UA server that server.py and opcua_discover.py talk to
OPCUA_ENDPOINT=opc.tcp://127.0.0.1:4841/avevawaterSimulator
# Only if that server needs a login; leave unset for anonymous
# OPCUA_USERNAME=
# OPCUA_PASSWORD=

# Discovery settings (discover_plant and opcua_discover.py)
OPCUA_NAMESPACE_URI=urn:avevawaterSimulator
OPCUA_WTP_PATH=Plant.WTP

# MCP server port
FASTMCP_PORT=8002
